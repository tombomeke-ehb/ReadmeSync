<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>ReadmeSync</RootNamespace>

		<!-- CLI tool packaging -->
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>readmesync</ToolCommandName>

		<!-- Package metadata -->
		<PackageId>ReadmeSync</PackageId>
		<Version>1.4.0</Version>
		<Authors>Tombomeke Studios</Authors>
		<Company>Tombomeke Studios</Company>
		<Description>A lightweight C# CLI tool that auto-generates README or ROADMAP files based on your project's structure. Now with PHP, Python and TypeScript support!</Description>
		<PackageTags>readme roadmap csharp java php python typescript documentation cli generator tombomeke</PackageTags>

		<!-- License & URLs -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/tombomeke-ehb/ReadmeSync</RepositoryUrl>
		<PackageProjectUrl>https://github.com/tombomeke-ehb/ReadmeSync</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Point to README (parent directory) -->
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Output -->
		<PackageOutputPath>./nupkg</PackageOutputPath>
		<IncludeSymbols>false</IncludeSymbols>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<!-- Include README from parent directory -->
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ReadmeSync.Core\ReadmeSync.Core.csproj" />
	</ItemGroup>

</Project>
